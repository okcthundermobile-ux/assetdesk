rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffEditor() {
      return signedIn()
        && profile().partnerID == null
        && profile().permissions in ['Edit', 'Admin'];
    }

    function ownsPartner(partnerID) {
      return signedIn() && profile().partnerID == partnerID;
    }

    // Accounts created through the app receive view-only access. Assign
    // staff/editor access and partner IDs through the trusted admin workflow.
    match /users/{userID} {
      allow create: if signedIn()
        && request.auth.uid == userID
        && request.resource.data.permissions == 'View'
        && request.resource.data.partnerID == null;
      allow read: if signedIn() && request.auth.uid == userID;
    }

    match /partners/{documentID} {
      allow read: if signedIn();
      allow write: if isStaffEditor();
    }

    match /kpis/{documentID} {
      allow read: if signedIn();
      allow write: if isStaffEditor();
    }

    match /games/{documentID} {
      allow read: if signedIn();
      allow write: if isStaffEditor();
    }

    match /campaigns/{documentID} {
      allow read: if signedIn();
      allow write: if isStaffEditor();
    }

    match /locations/{documentID} {
      allow read: if signedIn();
      allow write: if isStaffEditor();
    }

    match /assets/{documentID} {
      allow read: if signedIn();
      allow write: if isStaffEditor();
    }

    match /activations/{activationID} {
      allow read: if signedIn();
      allow create: if isStaffEditor() || ownsPartner(request.resource.data.Partner_ID);
      allow update, delete: if isStaffEditor() || ownsPartner(resource.data.Partner_ID);
    }
  }
}
